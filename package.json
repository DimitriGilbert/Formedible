{
  "name": "formedible",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:pkg": "pnpm --filter @formedible/formedible run build",
    "build:parser": "pnpm --filter @formedible/formedible-parser run build",
    "build:builder": "pnpm --filter @formedible/builder run build",
    "build:ai-builder": "pnpm --filter @formedible/ai-builder run build",
    "build:web": "pnpm --dir apps/web run build",
    "build:registries": "node scripts/build-registries.js",
    "build:release": "node scripts/build-release.js",
    "check-types": "turbo check-types && tsc -p tests/compatibility-examples/tsconfig.json && pnpm test:formedible:types && tsc -p tests/architecture/tsconfig.json && tsc -p tests/sync/tsconfig.json && tsc -p tests/consumer-smoke/tsconfig.json",
    "check-types:pkg": "pnpm --filter @formedible/formedible run check-types",
    "check-types:parser": "pnpm --filter @formedible/formedible-parser run check-types",
    "check-types:builder": "pnpm --filter @formedible/builder run check-types",
    "check-types:ai-builder": "pnpm --filter @formedible/ai-builder run check-types",
    "check-types:web": "pnpm --dir apps/web run check-types",
    "sync-components": "node scripts/quick-sync.js",
    "test:formedible:types": "tsc -p tests/formedible/tsconfig.types.json",
    "test:formedible:normalization": "tsc -p tests/formedible/tsconfig.json && tsx --tsconfig tests/formedible/tsconfig.json --test tests/formedible/*.test.ts",
    "test:formedible:validation": "tsc -p tests/formedible/validation/tsconfig.json && tsx --tsconfig tests/formedible/validation/tsconfig.json --test tests/formedible/validation/*.test.tsx",
    "test:architecture": "tsc -p tests/architecture/tsconfig.json && node --test tests/architecture/.compiled/*.test.js",
    "test:formedible:basic-fields": "tsc -p tests/formedible/tsconfig.basic-fields.json && tsx --tsconfig tests/formedible/tsconfig.basic-fields.json --test tests/formedible/basic-fields.test.tsx",
    "test:formedible:section-rendering": "tsc -p tests/formedible/tsconfig.basic-fields.json && tsx --tsconfig tests/formedible/tsconfig.basic-fields.json --test tests/formedible/section-rendering.test.tsx",
    "test:formedible:advanced-fields": "tsc -p tests/formedible/tsconfig.advanced-fields.json && tsx --tsconfig tests/formedible/tsconfig.advanced-fields.json --test tests/formedible/advanced-fields.test.tsx",
    "test:formedible:advanced-fields:ssr": "tsc -p tests/formedible/tsconfig.advanced-fields.json && tsx --tsconfig tests/formedible/tsconfig.advanced-fields.json --test tests/formedible/advanced-fields-ssr-import.test.tsx",
    "test:formedible:nested-fields": "tsc -p tests/formedible/tsconfig.nested-fields.json && tsx --tsconfig tests/formedible/tsconfig.nested-fields.json --test tests/formedible/nested-fields.test.tsx",
    "test:formedible:phase10": "tsc -p tests/formedible/tsconfig.phase10.json && tsx --tsconfig tests/formedible/tsconfig.phase10.json --test tests/formedible/phase10-behavior.test.ts",
    "test:sync": "tsc -p tests/sync/tsconfig.json && node --test tests/sync/.compiled/*.test.js && node scripts/validate-sync-boundaries.js",
    "test:consumer-smoke": "tsc -p tests/consumer-smoke/tsconfig.json && node --test tests/consumer-smoke/.compiled/*.test.js",
    "test:e2e": "pnpm --dir apps/web build && tsc -p tests/e2e/tsconfig.json && node --test tests/e2e/.compiled/*.test.js",
    "test:e2e:existing": "tsc -p tests/e2e/tsconfig.json && node --test tests/e2e/.compiled/*.test.js",
    "dev:web": "turbo -F web dev"
  },
  "dependencies": {
    "@formedible/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formedible/config": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "agent-browser": "^0.27.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.10.0"
}
