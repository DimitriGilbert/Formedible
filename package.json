{
  "name": "formedible",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types && tsc -p tests/compatibility-examples/tsconfig.json && pnpm test:formedible:types && tsc -p tests/architecture/tsconfig.json && tsc -p tests/sync/tsconfig.json",
    "test:formedible:types": "tsc -p tests/formedible/tsconfig.types.json",
    "test:formedible:normalization": "tsc -p tests/formedible/tsconfig.json && tsx --tsconfig tests/formedible/tsconfig.json --test tests/formedible/*.test.ts",
    "test:formedible:validation": "tsc -p tests/formedible/validation/tsconfig.json && tsx --tsconfig tests/formedible/validation/tsconfig.json --test tests/formedible/validation/*.test.tsx",
    "test:architecture": "tsc -p tests/architecture/tsconfig.json && node --test tests/architecture/.compiled/*.test.js",
    "test:formedible:basic-fields": "tsc -p tests/formedible/tsconfig.basic-fields.json && tsx --tsconfig tests/formedible/tsconfig.basic-fields.json --test tests/formedible/basic-fields.test.tsx",
    "test:sync": "tsc -p tests/sync/tsconfig.json && node --test tests/sync/.compiled/*.test.js",
    "dev:web": "turbo -F web dev"
  },
  "dependencies": {
    "@formedible/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formedible/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "^2.8.12",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.10.0"
}
