{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "formedible-ai-picker",
  "homepage": "https://formedible.dev",
  "items": [
    {
      "name": "ai-picker",
      "type": "registry:block",
      "title": "Formedible AI Picker",
      "description": "AI provider picker with model selection, API key management, and storage preferences.",
      "dependencies": [
        "@tanstack/ai",
        "@tanstack/ai-anthropic",
        "@tanstack/ai-openai",
        "@tanstack/ai-openrouter",
        "@tanstack/react-form",
        "clsx",
        "lucide-react",
        "tailwind-merge",
        "zod"
      ],
      "registryDependencies": [
        "https://formedible.dev/r/formedible-core.json",
        "popover"
      ],
      "files": [
        {
          "path": "src/index.ts",
          "type": "registry:lib",
          "target": "@ui/formedible/ai-picker/index.ts"
        },
        {
          "path": "src/lib/ai-picker-types.ts",
          "type": "registry:lib",
          "target": "@ui/formedible/ai-picker/lib/ai-picker-types.ts"
        },
        {
          "path": "src/lib/default-picker-schema.ts",
          "type": "registry:lib",
          "target": "@ui/formedible/ai-picker/lib/default-picker-schema.ts"
        },
        {
          "path": "src/lib/ai-picker-utils.ts",
          "type": "registry:lib",
          "target": "@ui/formedible/ai-picker/lib/ai-picker-utils.ts"
        },
        {
          "path": "src/components/ai-picker/model-autocomplete-field.tsx",
          "type": "registry:component",
          "target": "@ui/formedible/ai-picker/components/model-autocomplete-field.tsx"
        },
        {
          "path": "src/components/ai-picker/ai-picker-panel.tsx",
          "type": "registry:component",
          "target": "@ui/formedible/ai-picker/components/ai-picker-panel.tsx"
        },
        {
          "path": "src/components/ai-picker/ai-picker-popover.tsx",
          "type": "registry:component",
          "target": "@ui/formedible/ai-picker/components/ai-picker-popover.tsx"
        },
        {
          "path": "src/components/ai-picker/ai-picker.tsx",
          "type": "registry:component",
          "target": "@ui/formedible/ai-picker/components/ai-picker.tsx"
        }
      ]
    }
  ]
}
