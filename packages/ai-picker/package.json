{
  "name": "@formedible/ai-picker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "sh -c 'if find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) | read; then tsc --noEmit; fi'",
    "test": "node --import ../../scripts/register-package-alias-loader.mjs --import tsx --test src/**/*.test.tsx src/**/*.test.ts",
    "build": "pnpm run check-types",
    "build:registry": "shadcn build"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@tanstack/ai": "^0.52.0",
    "@tanstack/ai-anthropic": "^0.18.3",
    "@tanstack/ai-openai": "^0.22.3",
    "@tanstack/ai-openrouter": "^0.19.5",
    "@tanstack/react-form": "^1.27.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "tailwind-merge": "^3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formedible/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
