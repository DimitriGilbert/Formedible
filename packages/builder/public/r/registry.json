{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "formedible-builder",
  "homepage": "https://formedible.dev",
  "items": [
    {
      "name": "form-builder",
      "type": "registry:block",
      "title": "Formedible Builder",
      "description": "Visual Formedible builder with field configuration, preview, default tabs, field store, and code generation.",
      "dependencies": [
        "@base-ui/react",
        "@tanstack/react-form",
        "clsx",
        "lucide-react",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/index.ts",
          "type": "registry:lib",
          "target": "components/formedible/builder/index.ts"
        },
        {
          "path": "src/components/formedible/builder/form-builder.tsx",
          "type": "registry:component",
          "target": "components/formedible/builder/form-builder.tsx"
        },
        {
          "path": "src/components/formedible/builder/field-configurator.tsx",
          "type": "registry:component",
          "target": "components/formedible/builder/field-configurator.tsx"
        },
        {
          "path": "src/components/formedible/builder/form-preview.tsx",
          "type": "registry:component",
          "target": "components/formedible/builder/form-preview.tsx"
        },
        {
          "path": "src/components/formedible/builder/code-generator.tsx",
          "type": "registry:component",
          "target": "components/formedible/builder/code-generator.tsx"
        },
        {
          "path": "src/components/formedible/builder/field-store.ts",
          "type": "registry:lib",
          "target": "components/formedible/builder/field-store.ts"
        },
        {
          "path": "src/components/formedible/builder/default-tabs.tsx",
          "type": "registry:lib",
          "target": "components/formedible/builder/default-tabs.tsx"
        },
        {
          "path": "src/lib/formedible/builder-types.ts",
          "type": "registry:lib",
          "target": "lib/formedible/builder-types.ts"
        },
        {
          "path": "src/lib/formedible/code-generation.ts",
          "type": "registry:lib",
          "target": "lib/formedible/code-generation.ts"
        }
      ]
    }
  ]
}
