{
  "name": "@formedible/formedible-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "sh -c 'if find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) | read; then tsc --noEmit; fi'",
    "test": "tsx --test src/**/*.test.ts",
    "build": "pnpm run check-types",
    "build:registry": "shadcn build",
    "sync": "node ../../scripts/quick-sync.js --root ../.. --config packages/formedible-parser/sync.config.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@tanstack/react-form": "^1.27.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@formedible/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "shadcn": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
