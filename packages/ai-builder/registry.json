        "@base-ui/react",
        "@tanstack/ai",
        "@tanstack/ai-anthropic",
        "@tanstack/ai-openai",
        "@tanstack/ai-openrouter",
        "@tanstack/react-form",
        "clsx",
        "lucide-react",
        "react-markdown",
        "rehype-highlight",
        "remark-gfm",
        "tailwind-merge",
        "zod"
      ],
      "files": [
        {
          "path": "src/index.ts",
          "type": "registry:lib",
          "target": "components/formedible/ai/index.ts"
        },
        {
