{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "formedible-ai-builder",
  "homepage": "https://formedible.dev",
  "items": [
    {
      "name": "ai-builder",
      "type": "registry:block",
      "title": "Formedible AI Builder",
      "description": "AI-assisted Formedible builder with provider selection, chat, parser integration, and live renderer.",
